#!/usr/bin/env python3
"""Migrate preserved Argent Sentinel configuration without replacing policy."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import stat
import tempfile
from typing import Any, Mapping


class MigrationError(RuntimeError):
    pass


def load(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise MigrationError(f"Configuration root must be an object: {path}")
    return value


def append_missing(target: list[str], required: list[str]) -> bool:
    changed = False
    for item in required:
        if item not in target:
            target.append(item)
            changed = True
    return changed


def merge_missing(target: dict[str, Any], source: Mapping[str, Any]) -> bool:
    # Existing nested configuration is operator-owned. Add only wholly absent
    # top-level sections; release-specific nested keys are migrated explicitly.
    changed = False
    for key, value in source.items():
        if key not in target:
            target[key] = value
            changed = True
    return changed



def migrate_report_batching_defaults(
    config: dict[str, Any],
    example: Mapping[str, Any],
) -> bool:
    """Add only absent 0.5.1.1 reporting keys to preserved config."""

    batching = config.get("report_batching")
    example_batching = example.get("report_batching")
    if not isinstance(batching, dict) or not isinstance(
        example_batching, Mapping
    ):
        raise MigrationError("report_batching must be an object")

    changed = False
    if "state_file" not in batching:
        state_file = example_batching.get("state_file")
        if not isinstance(state_file, str) or not state_file.strip():
            raise MigrationError(
                "example report_batching.state_file must be a non-empty string"
            )
        batching["state_file"] = state_file
        changed = True

    example_grouping = example_batching.get("grouping")
    if not isinstance(example_grouping, Mapping):
        raise MigrationError(
            "example report_batching.grouping must be an object"
        )

    grouping = batching.get("grouping")
    if grouping is None:
        grouping = {}
        batching["grouping"] = grouping
        changed = True
    if not isinstance(grouping, dict):
        raise MigrationError("report_batching.grouping must be an object")

    for key in (
        "minimum_ipv4_prefix_length",
        "minimum_ipv6_prefix_length",
    ):
        if key not in grouping:
            grouping[key] = example_grouping[key]
            changed = True

    return changed

def migrate_known_defaults(config: dict[str, Any]) -> bool:
    changed = False
    sshd = config.get("sshd_policy")
    if isinstance(sshd, dict):
        old = {
            "window_seconds": 120,
            "failure_threshold": 8,
            "distinct_accounts": 3,
            "single_account_threshold": 12,
            "incident_merge_seconds": 300,
        }
        if all(sshd.get(key) == value for key, value in old.items()):
            sshd.update(
                {
                    "window_seconds": 3600,
                    "failure_threshold": 1,
                    "distinct_accounts": 1,
                    "single_account_threshold": 1,
                    "incident_merge_seconds": 86400,
                }
            )
            changed = True
    policy = config.get("policy")
    if isinstance(policy, dict):
        old = {
            "window_seconds": 60,
            "failure_threshold": 5,
            "distinct_accounts": 2,
            "single_account_threshold": 10,
            "incident_merge_seconds": 300,
        }
        if all(policy.get(key) == value for key, value in old.items()):
            policy["window_seconds"] = 900
            policy["incident_merge_seconds"] = 86400
            changed = True
    web = config.get("web_policy")
    if isinstance(web, dict):
        for key, value in (
            ("immediate_statuses", [444]),
            ("review_statuses", [429]),
        ):
            if key not in web:
                web[key] = value
                changed = True
        if web.get("incident_merge_seconds") == 1800:
            web["incident_merge_seconds"] = 86400
            changed = True
    protection = config.get("enforcement_protection")
    if isinstance(protection, dict):
        for key, value in (
            (
                "dynamic_state_file",
                "/var/lib/argent-sentinel/collector/effective-protected-cidrs.json",
            ),
            ("dynamic_state_max_age_seconds", 600),
        ):
            if key not in protection:
                protection[key] = value
                changed = True
    return changed


def atomic_write(path: Path, value: Mapping[str, Any], mode: int) -> None:
    payload = json.dumps(value, indent=2, sort_keys=True) + "\n"
    with tempfile.NamedTemporaryFile(
        prefix=f".{path.name}.",
        dir=path.parent,
        mode="w",
        encoding="utf-8",
        delete=False,
    ) as handle:
        temporary = Path(handle.name)
        handle.write(payload)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, mode)
    os.replace(temporary, path)


def migrate(
    config_path: Path,
    example_path: Path,
    backup: Path | None,
    *,
    top_level_only: bool = False,
) -> dict[str, Any]:
    config = load(config_path)
    example = load(example_path)
    changed = merge_missing(config, example)
    if top_level_only:
        if backup is not None:
            backup.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            os.chmod(backup.parent, 0o700)
            shutil.copy2(config_path, backup)
            os.chmod(backup, 0o600)
        if changed:
            mode = stat.S_IMODE(config_path.stat().st_mode) or 0o600
            atomic_write(config_path, config, mode)
        return {
            "status": "updated" if changed else "unchanged",
            "config": str(config_path),
            "backup": str(backup) if backup else None,
        }

    changed = migrate_report_batching_defaults(config, example) or changed

    incoming = config.get("incoming_globs")
    required = example.get("incoming_globs")
    if not isinstance(incoming, list) or not isinstance(required, list):
        raise MigrationError("incoming_globs must be arrays")
    changed = append_missing(incoming, required) or changed

    context = config.get("abuse_context")
    example_context = example.get("abuse_context")
    if not isinstance(context, dict) or not isinstance(example_context, dict):
        raise MigrationError("abuse_context must be an object")
    context_globs = context.get("incoming_globs", [])
    required_context = example_context.get("incoming_globs")
    if not isinstance(context_globs, list) or not isinstance(required_context, list):
        raise MigrationError("abuse_context.incoming_globs must be arrays")
    changed = append_missing(context_globs, required_context) or changed
    context["incoming_globs"] = context_globs
    changed = migrate_known_defaults(config) or changed

    if backup is not None:
        backup.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(backup.parent, 0o700)
        shutil.copy2(config_path, backup)
        os.chmod(backup, 0o600)

    if changed:
        mode = stat.S_IMODE(config_path.stat().st_mode) or 0o600
        atomic_write(config_path, config, mode)

    return {
        "status": "updated" if changed else "unchanged",
        "config": str(config_path),
        "backup": str(backup) if backup else None,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", required=True)
    parser.add_argument("--example", required=True)
    parser.add_argument("--backup")
    parser.add_argument(
        "--top-level-only",
        action="store_true",
        help="merge only wholly absent top-level keys",
    )
    args = parser.parse_args()
    try:
        result = migrate(
            Path(args.config),
            Path(args.example),
            Path(args.backup) if args.backup else None,
            top_level_only=args.top_level_only,
        )
    except (OSError, json.JSONDecodeError, MigrationError) as exc:
        print(json.dumps({"status": "error", "error": str(exc)}))
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
