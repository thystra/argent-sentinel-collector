#!/bin/sh
# File: /home/alan/src/argent-sentinel-collector/packaging/deb/agent.config
set -e

. /usr/share/debconf/confmodule

CONFIG=/etc/argent-sentinel/agent.json
DISCOVERY=/run/argent-sentinel/local-protection-debconf.json

has_local_config=false
if [ -f "$CONFIG" ]; then
    if python3 - "$CONFIG" <<'PY' >/dev/null 2>&1
import json
import sys
from pathlib import Path
value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
raise SystemExit(0 if isinstance(value.get("local_address_protection"), dict) else 1)
PY
    then
        has_local_config=true
    fi
fi

if [ "$has_local_config" = true ] && [ "${DEBCONF_RECONFIGURE:-0}" != 1 ]; then
    db_set argent-sentinel-agent/protection-apply false
    db_stop
    exit 0
fi

install -d -m 0755 /run/argent-sentinel
# The debconf config script runs before the new package payload is unpacked.
# Keep discovery self-contained instead of depending on the installed helper.
python3 - "$DISCOVERY" <<'PYDISCOVERY' >/dev/null 2>&1 || true
import ipaddress
import json
import re
import subprocess
import sys
from pathlib import Path

output = Path(sys.argv[1])
public = ipaddress.ip_network("2000::/3")
excluded = re.compile(
    r"^(?:lo|docker\d*|br-|veth|virbr|tun\d*|tap\d*|wg\d*|"
    r"tailscale\d*|zt\w*|cni\d*|flannel\d*|podman\d*|lxc\w*|"
    r"lxd\w*|dummy\d*|sit\d*|ip6tnl\d*|gre\d*|gretap\d*|"
    r"vxlan\d*)",
    re.IGNORECASE,
)


def command_json(command):
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        timeout=15,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "command failed")
    value = json.loads(result.stdout or "[]")
    if not isinstance(value, list):
        raise RuntimeError("unexpected JSON root")
    return value


def flag(item, name):
    if bool(item.get(name)):
        return True
    values = item.get("flags", [])
    return isinstance(values, list) and name.lower() in {
        str(value).lower() for value in values
    }


try:
    route_rows = command_json(["ip", "-j", "-6", "route", "show", "default"])
    address_rows = command_json(["ip", "-j", "-6", "address", "show"])
    routes = []
    for row in route_rows:
        if not isinstance(row, dict) or not row.get("dev"):
            continue
        routes.append(
            {
                "interface": str(row["dev"]),
                "gateway": str(row.get("gateway") or "") or None,
                "protocol": str(row.get("protocol") or row.get("proto") or "") or None,
                "metric": row.get("metric"),
            }
        )
    default_interfaces = {item["interface"] for item in routes}
    addresses = []
    for interface_row in address_rows:
        if not isinstance(interface_row, dict):
            continue
        interface = str(interface_row.get("ifname") or "")
        if not interface or interface not in default_interfaces or excluded.match(interface):
            continue
        for raw in interface_row.get("addr_info", []):
            if not isinstance(raw, dict) or raw.get("family") != "inet6":
                continue
            try:
                address = ipaddress.ip_address(str(raw.get("local") or ""))
                prefix_length = int(raw.get("prefixlen", 128))
            except (ValueError, TypeError):
                continue
            if address not in public or not 1 <= prefix_length <= 128:
                continue
            if any(flag(raw, name) for name in ("tentative", "dadfailed", "deprecated")):
                continue
            addresses.append(
                {
                    "interface": interface,
                    "address": str(address),
                    "prefix_length": prefix_length,
                    "network": str(
                        ipaddress.ip_network(
                            f"{address}/{prefix_length}",
                            strict=False,
                        )
                    ),
                    "dynamic": flag(raw, "dynamic"),
                }
            )
except Exception:
    routes = []
    addresses = []
    default_interfaces = set()

try:
    detected = subprocess.run(
        ["systemd-detect-virt"],
        text=True,
        capture_output=True,
        timeout=10,
        check=False,
    )
    virt_text = (detected.stdout or "").strip().lower()
    if detected.returncode == 0 and virt_text and virt_text != "none":
        virtualization = {"type": virt_text, "is_virtual": True}
    elif virt_text == "none" or detected.returncode == 1:
        virtualization = {"type": "none", "is_virtual": False}
    else:
        virtualization = {"type": virt_text or "unknown", "is_virtual": None}
except Exception:
    virtualization = {"type": "unknown", "is_virtual": None}

interfaces = sorted({item["interface"] for item in addresses})
prefixes = sorted({item["network"] for item in addresses})
route_protocols = {
    str(item.get("protocol") or "").lower() for item in routes
}
has_ra_signal = "ra" in route_protocols or any(item["dynamic"] for item in addresses)
prefixes_are_safely_bounded = all(
    int(item.get("prefix_length", 128)) >= 48 for item in addresses
)
if virtualization["is_virtual"] is True:
    mode = "host"
    reason = (
        f"Virtualization type {virtualization['type']} was detected. "
        "A provider-visible /64 does not prove control of the whole prefix."
    )
elif (
    addresses
    and virtualization["is_virtual"] is False
    and has_ra_signal
    and prefixes_are_safely_bounded
):
    mode = "lan-prefix"
    reason = (
        "This appears to be a physical host using router-advertised or dynamically "
        "assigned public IPv6. Choose LAN-prefix mode only if you own or control "
        "the displayed prefix."
    )
elif addresses:
    mode = "host"
    reason = (
        "A connected prefix broader than /48 cannot be published as dynamic "
        "LAN protection, so individual /128 protection is recommended."
        if not prefixes_are_safely_bounded
        else (
            "The environment is not confidently identifiable as an operator-owned "
            "LAN, so individual /128 protection is recommended."
        )
    )
else:
    mode = "host"
    reason = (
        "No qualifying public IPv6 address was found. Host mode is the safe "
        "default and will protect addresses dynamically when they appear."
    )

payload = {
    "addresses": sorted(addresses, key=lambda item: (item["interface"], item["address"])),
    "default_route_interfaces": sorted(default_interfaces),
    "recommendation": {
        "interfaces": interfaces,
        "mode": mode,
        "prefixes": prefixes,
        "reason": reason,
    },
    "virtualization": virtualization,
}
output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PYDISCOVERY
if [ ! -s "$DISCOVERY" ]; then
    cat > "$DISCOVERY" <<'JSON'
{
  "addresses": [],
  "default_route_interfaces": [],
  "recommendation": {
    "interfaces": [],
    "mode": "host",
    "prefixes": [],
    "reason": "Discovery was unavailable, so host mode is the conservative default."
  },
  "virtualization": {"is_virtual": null, "type": "unknown"}
}
JSON
fi

SUMMARY=$(python3 - "$DISCOVERY" <<'PY'
import json
import sys
from pathlib import Path
value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
virt = value.get("virtualization", {}).get("type", "unknown")
addresses = value.get("addresses", [])
lines = [f"Environment: {virt}"]
if addresses:
    lines.append("Detected public IPv6 addresses:")
    for item in addresses:
        lines.append(
            f"  {item.get('interface')}: {item.get('address')}/{item.get('prefix_length')}"
        )
else:
    lines.append("Detected public IPv6 addresses: none")
recommendation = value.get("recommendation", {})
prefixes = recommendation.get("prefixes", [])
lines.append("Candidate LAN prefixes: " + (", ".join(str(item) for item in prefixes) or "none"))
lines.append(f"Recommended mode: {recommendation.get('mode', 'host')}")
lines.append(str(recommendation.get("reason", "")))
print("\\n".join(lines))
PY
)
RECOMMENDATION=$(python3 - "$DISCOVERY" <<'PY'
import json
import sys
from pathlib import Path
value=json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
print(value.get("recommendation", {}).get("mode", "host"))
PY
)
PREFIXES=$(python3 - "$DISCOVERY" <<'PY'
import json
import sys
from pathlib import Path
value=json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
prefixes=value.get("recommendation", {}).get("prefixes", [])
print(", ".join(str(item) for item in prefixes) or "none")
PY
)

if [ "$has_local_config" = true ]; then
    CURRENT=$(python3 - "$CONFIG" <<'PY'
import json
import sys
from pathlib import Path
value=json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
local=value.get("local_address_protection", {})
print(local.get("mode", "host"))
print(",".join(str(item) for item in local.get("interfaces", [])))
print(",".join(str(item) for item in local.get("manual_cidrs", [])))
PY
)
    CURRENT_MODE=$(printf '%s\n' "$CURRENT" | sed -n '1p')
    CURRENT_INTERFACES=$(printf '%s\n' "$CURRENT" | sed -n '2p')
    CURRENT_MANUAL=$(printf '%s\n' "$CURRENT" | sed -n '3p')
    db_set argent-sentinel-agent/protection-mode "${CURRENT_MODE:-host}"
    db_set argent-sentinel-agent/protection-interfaces "$CURRENT_INTERFACES"
    db_set argent-sentinel-agent/manual-cidrs "$CURRENT_MANUAL"
else
    db_set argent-sentinel-agent/protection-mode "$RECOMMENDATION"
    # Follow current IPv6 default-route interfaces dynamically. Operators may
    # set an explicit interface list later in agent.json when required.
    db_set argent-sentinel-agent/protection-interfaces ""
fi

db_set argent-sentinel-agent/protection-apply true

if [ "${DEBIAN_FRONTEND:-}" = noninteractive ]; then
    db_set argent-sentinel-agent/protection-mode host
    db_set argent-sentinel-agent/protection-confirmed false
    db_set argent-sentinel-agent/protection-source noninteractive-default
    db_stop
    exit 0
fi

db_subst argent-sentinel-agent/protection-discovery SUMMARY "$SUMMARY"
db_fset argent-sentinel-agent/protection-discovery seen false
db_input high argent-sentinel-agent/protection-discovery || true
db_go || true

db_fset argent-sentinel-agent/protection-mode seen false
db_input high argent-sentinel-agent/protection-mode || true
db_go || true
db_get argent-sentinel-agent/protection-mode
MODE=$RET

case "$MODE" in
    lan-prefix)
        db_subst argent-sentinel-agent/lan-confirm PREFIXES "$PREFIXES"
        db_set argent-sentinel-agent/lan-confirm false
        db_fset argent-sentinel-agent/lan-confirm seen false
        db_input critical argent-sentinel-agent/lan-confirm || true
        db_go || true
        db_get argent-sentinel-agent/lan-confirm
        if [ "$RET" = true ]; then
            db_set argent-sentinel-agent/protection-confirmed true
        else
            db_set argent-sentinel-agent/protection-mode host
            db_set argent-sentinel-agent/protection-confirmed true
            db_subst argent-sentinel-agent/protection-warning WARNING \
                "LAN-prefix mode was not confirmed. Sentinel selected host mode instead. Run dpkg-reconfigure argent-sentinel-agent to review the choice."
            db_fset argent-sentinel-agent/protection-warning seen false
            db_input critical argent-sentinel-agent/protection-warning || true
            db_go || true
        fi
        ;;
    manual)
        db_fset argent-sentinel-agent/manual-cidrs seen false
        db_input high argent-sentinel-agent/manual-cidrs || true
        db_go || true
        db_get argent-sentinel-agent/manual-cidrs
        MANUAL=$RET
        if python3 - "$MANUAL" <<'PY' >/dev/null 2>&1
import ipaddress
import re
import sys
values=[item for item in re.split(r"[\s,]+", sys.argv[1].strip()) if item]
if not values:
    raise SystemExit(1)
for value in values:
    network = ipaddress.ip_network(value, strict=False)
    minimum = 24 if network.version == 4 else 48
    if network.prefixlen < minimum:
        raise SystemExit(1)
PY
        then
            db_set argent-sentinel-agent/protection-confirmed true
        else
            db_set argent-sentinel-agent/protection-mode host
            db_set argent-sentinel-agent/protection-confirmed true
            db_subst argent-sentinel-agent/protection-warning WARNING \
                "Manual mode did not contain a valid CIDR. Sentinel selected host mode instead. Run dpkg-reconfigure argent-sentinel-agent to try again."
            db_fset argent-sentinel-agent/protection-warning seen false
            db_input critical argent-sentinel-agent/protection-warning || true
            db_go || true
        fi
        ;;
    host|off)
        db_set argent-sentinel-agent/protection-confirmed true
        ;;
    *)
        db_set argent-sentinel-agent/protection-mode host
        db_set argent-sentinel-agent/protection-confirmed false
        db_set argent-sentinel-agent/protection-source safe-default
        ;;
esac

db_set argent-sentinel-agent/protection-source debconf
db_stop
exit 0

# EOF: /home/alan/src/argent-sentinel-collector/packaging/deb/agent.config
