#!/bin/sh
set -e
case "$1" in
  install|upgrade)
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
      systemctl stop argent-sentinel-api.service argent-sentinel-collector.timer argent-sentinel-collector.service argent-sentinel-watchdog.timer argent-sentinel-watchdog.service >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
