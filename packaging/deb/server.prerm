#!/bin/sh

set -e

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ] &&
           command -v systemctl >/dev/null 2>&1; then
            systemctl stop                 argent-sentinel-api.service                 argent-sentinel-collector.timer                 argent-sentinel-collector.service                 argent-sentinel-report-batch.timer                 argent-sentinel-report-batch.service                 argent-sentinel-nginx-logrotate.timer                 argent-sentinel-nginx-logrotate.service                 argent-sentinel-fail2ban-export.timer                 argent-sentinel-fail2ban-export.service                 argent-sentinel-review-digest.timer                 argent-sentinel-review-digest.service                 argent-sentinel-nginx-429-export.timer                 argent-sentinel-nginx-429-export.service                 argent-sentinel-dashboard.service                 argent-sentinel-review-processor.path                 argent-sentinel-review-processor.service                 argent-sentinel-dashboard-snapshot.timer                 argent-sentinel-dashboard-snapshot.service                 argent-sentinel-awstats.timer                 argent-sentinel-awstats.service                 >/dev/null 2>&1 || true
            systemctl disable                 argent-sentinel-api.service                 argent-sentinel-collector.timer                 argent-sentinel-report-batch.timer                 argent-sentinel-nginx-logrotate.timer                 argent-sentinel-fail2ban-export.timer                 argent-sentinel-review-digest.timer                 argent-sentinel-nginx-429-export.timer                 argent-sentinel-dashboard.service                 argent-sentinel-review-processor.path                 argent-sentinel-dashboard-snapshot.timer                 argent-sentinel-awstats.timer                 >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
