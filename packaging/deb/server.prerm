#!/bin/sh

set -e

case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ] &&
           command -v systemctl >/dev/null 2>&1; then
            systemctl stop                 argent-sentinel-api.service                 argent-sentinel-collector.timer                 argent-sentinel-collector.service                 argent-sentinel-nginx-logrotate.timer                 argent-sentinel-nginx-logrotate.service                 argent-sentinel-fail2ban-export.timer                 argent-sentinel-fail2ban-export.service                 argent-sentinel-review-digest.timer                 argent-sentinel-review-digest.service                 >/dev/null 2>&1 || true
            systemctl disable                 argent-sentinel-api.service                 argent-sentinel-collector.timer                 argent-sentinel-nginx-logrotate.timer                 argent-sentinel-fail2ban-export.timer                 argent-sentinel-review-digest.timer                 >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
