#!/bin/sh

set -e

CONFIG=/etc/argent-sentinel/collector.json
EXAMPLE=/usr/share/argent-sentinel/collector.json.example
API_CONFIG=/etc/argent-sentinel/server-api.json
API_EXAMPLE=/usr/share/argent-sentinel/server-api.json.example
DASH_CONFIG=/etc/argent-sentinel/dashboard.json
DASH_EXAMPLE=/usr/share/argent-sentinel/dashboard.json.example
SNAP_CONFIG=/etc/argent-sentinel/dashboard-snapshot.json
SNAP_EXAMPLE=/usr/share/argent-sentinel/dashboard-snapshot.json.example
REVIEW_CONFIG=/etc/argent-sentinel/review-processor.json
REVIEW_EXAMPLE=/usr/share/argent-sentinel/review-processor.json.example
TRAFFIC_CONFIG=/etc/argent-sentinel/traffic-sites.json
TRAFFIC_EXAMPLE=/usr/share/argent-sentinel/traffic-sites.json.example
NGINX_LOGROTATE_CONFIG=/etc/logrotate.d/argent-sentinel-nginx
NGINX_LOGROTATE_EXAMPLE=/usr/share/argent-sentinel/argent-sentinel-nginx.logrotate
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
PACKAGE_VERSION="@PACKAGE_VERSION@"
BACKUP=/var/backups/argent-sentinel/package-$PACKAGE_VERSION-$STAMP
LEGACY_SERVICE_ARCHIVED=0

archive_legacy_unit() {
    unit=$1
    path=/etc/systemd/system/$unit
    [ -f "$path" ] || return 0

    legacy=0
    if grep -q '/usr/local/libexec/argent-sentinel/collector.py' "$path"; then
        legacy=1
    elif [ "$unit" = argent-sentinel-collector.timer ] &&
         [ "$LEGACY_SERVICE_ARCHIVED" -eq 1 ] &&
         grep -q '^Unit=argent-sentinel-collector.service$' "$path"; then
        legacy=1
    elif [ "$unit" = argent-sentinel-nginx-logrotate.service ] &&
         grep -q '/etc/logrotate.d/argent-sentinel-nginx' "$path"; then
        legacy=1
    elif [ "$unit" = argent-sentinel-nginx-logrotate.timer ] &&
         grep -q '^OnCalendar=hourly$' "$path" &&
         grep -q '^Unit=argent-sentinel-nginx-logrotate.service$' "$path"; then
        legacy=1
    fi

    if [ "$legacy" -eq 1 ]; then
        install -d -o root -g root -m 0700 "$BACKUP/legacy-systemd"
        mv "$path" "$BACKUP/legacy-systemd/$unit"
        if [ "$unit" = argent-sentinel-collector.service ]; then
            LEGACY_SERVICE_ARCHIVED=1
        fi
        echo "Archived legacy unit override: $path"
    else
        echo "WARNING: $path overrides the packaged unit and was left unchanged." >&2
    fi
}

case "$1" in
    configure)
        if ! getent group argent-sentinel-dashboard >/dev/null 2>&1; then
            addgroup --system argent-sentinel-dashboard
        fi
        if ! id argent-sentinel-dashboard >/dev/null 2>&1; then
            adduser --system --ingroup argent-sentinel-dashboard                 --home /nonexistent --no-create-home                 --shell /usr/sbin/nologin argent-sentinel-dashboard
        fi
        install -d -o root -g sentinel -m 0750 /var/lib/argent-sentinel
        # Keep private Sentinel state non-listable while allowing the
        # presentation tier to traverse only to sanitized publications.
        setfacl -m g:www-data:--x /var/lib/argent-sentinel
        install -d -o root -g root -m 0750 /var/lib/argent-sentinel/drop/fail2ban /var/lib/argent-sentinel/drop/fail2ban/incoming
        install -d -o root -g root -m 0750 /var/lib/argent-sentinel/drop/nginx /var/lib/argent-sentinel/drop/nginx/rate-review /var/lib/argent-sentinel/drop/nginx/rate-review/incoming /var/lib/argent-sentinel/collector/nginx-429-cursors
        install -d -o root -g www-data -m 0750 /var/lib/argent-sentinel/dashboard /var/lib/argent-sentinel/dashboard/awstats
        install -d -o root -g argent-sentinel-dashboard -m 0710             /var/spool/argent-sentinel/review
        install -d -o root -g argent-sentinel-dashboard -m 0730             /var/spool/argent-sentinel/review/incoming
        install -d -o root -g root -m 0700             /var/spool/argent-sentinel/review/processed             /var/spool/argent-sentinel/review/failed
        install -d -o root -g root -m 0755 /etc/awstats
        install -d -o root -g root -m 0750             /etc/argent-sentinel             /etc/argent-sentinel/nodes.d
        install -d -o root -g root -m 0700             /etc/argent-sentinel/pki             /var/backups/argent-sentinel
        install -d -o root -g root -m 0750             /var/lib/argent-sentinel/collector             /var/lib/argent-sentinel/collector/processing             /var/lib/argent-sentinel/collector/archive             /var/lib/argent-sentinel/collector/rejected             /var/lib/argent-sentinel/collector/abuse-context-processing             /var/lib/argent-sentinel/collector/abuse-context-archive             /var/lib/argent-sentinel/collector/abuse-context-rejected             /var/lib/argent-sentinel/server             /var/lib/argent-sentinel/drop/remote

        if [ ! -e "$CONFIG" ]; then
            install -o root -g root -m 0600 "$EXAMPLE" "$CONFIG"
            HOST_SHORT=$(hostname -s 2>/dev/null || hostname)
            HOST_FQDN=$(hostname -f 2>/dev/null || hostname)
            CONFIG="$CONFIG" HOST_SHORT="$HOST_SHORT" HOST_FQDN="$HOST_FQDN"                 python3 - <<'PY'
import json
import os
from pathlib import Path

path = Path(os.environ["CONFIG"])
config = json.loads(path.read_text())
config["node"]["id"] = os.environ["HOST_SHORT"]
config["node"]["fqdn"] = os.environ["HOST_FQDN"]
temporary = path.with_suffix(".json.tmp")
temporary.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
temporary.chmod(0o600)
temporary.replace(path)
PY
            echo "Installed disabled default configuration at $CONFIG"
        else
            chown root:root "$CONFIG"
            chmod 0600 "$CONFIG"
            echo "Preserved existing $CONFIG"
        fi

        if [ ! -e "$API_CONFIG" ]; then
            install -o root -g root -m 0640 "$API_EXAMPLE" "$API_CONFIG"
        else
            chown root:root "$API_CONFIG"
            chmod 0640 "$API_CONFIG"
        fi

        if [ ! -e "$DASH_CONFIG" ]; then
            install -o root -g root -m 0644 "$DASH_EXAMPLE" "$DASH_CONFIG"
        else
            chown root:root "$DASH_CONFIG"
            chmod 0644 "$DASH_CONFIG"
        fi
        if [ ! -e "$SNAP_CONFIG" ]; then
            install -o root -g root -m 0640 "$SNAP_EXAMPLE" "$SNAP_CONFIG"
        else
            chown root:root "$SNAP_CONFIG"
            chmod 0640 "$SNAP_CONFIG"
        fi
        if [ ! -e "$REVIEW_CONFIG" ]; then
            install -o root -g root -m 0640 "$REVIEW_EXAMPLE" "$REVIEW_CONFIG"
        else
            chown root:root "$REVIEW_CONFIG"
            chmod 0640 "$REVIEW_CONFIG"
        fi
        if [ ! -e "$TRAFFIC_CONFIG" ]; then
            install -o root -g root -m 0640 "$TRAFFIC_EXAMPLE" "$TRAFFIC_CONFIG"
        else
            chown root:root "$TRAFFIC_CONFIG"
            chmod 0640 "$TRAFFIC_CONFIG"
        fi
        if [ ! -e "$NGINX_LOGROTATE_CONFIG" ]; then
            install -o root -g root -m 0644                 "$NGINX_LOGROTATE_EXAMPLE"                 "$NGINX_LOGROTATE_CONFIG"
            echo "Installed default Nginx logrotate rule at $NGINX_LOGROTATE_CONFIG"
        else
            chown root:root "$NGINX_LOGROTATE_CONFIG"
            chmod 0644 "$NGINX_LOGROTATE_CONFIG"
            echo "Preserved existing $NGINX_LOGROTATE_CONFIG"
        fi

        # Prevent the minute collector from acquiring the shared lock while
        # package configuration migrates the preserved config and database.
        if [ -d /run/systemd/system ] &&
           command -v systemctl >/dev/null 2>&1; then
            systemctl stop argent-sentinel-collector.timer \
                >/dev/null 2>&1 || true
            WAIT_SECONDS=0
            while systemctl is-active --quiet \
                      argent-sentinel-collector.service &&
                  [ "$WAIT_SECONDS" -lt 30 ]; do
                sleep 1
                WAIT_SECONDS=$((WAIT_SECONDS + 1))
            done
            if systemctl is-active --quiet \
                 argent-sentinel-collector.service; then
                echo "Collector still active after 30 seconds; stopping it for package migration."
                systemctl stop argent-sentinel-collector.service \
                    >/dev/null 2>&1 || true
            fi
        fi

        install -d -o root -g root -m 0700 "$BACKUP"
        /usr/sbin/argent-sentinel-config-migrate \
            --config "$CONFIG" \
            --example "$EXAMPLE" \
            --backup "$BACKUP/collector.json.pre-v047"
        /usr/sbin/argent-sentinel-config-migrate \
            --config "$SNAP_CONFIG" \
            --example "$SNAP_EXAMPLE" \
            --backup "$BACKUP/dashboard-snapshot.json.pre-v0511" \
            --top-level-only

        archive_legacy_unit argent-sentinel-collector.service
        archive_legacy_unit argent-sentinel-collector.timer
        archive_legacy_unit argent-sentinel-nginx-logrotate.service
        archive_legacy_unit argent-sentinel-nginx-logrotate.timer

        # Remove the obsolete private state from the manually created timer.
        # Package-owned hourly and system-wide logrotate runs share the normal
        # /var/lib/logrotate/status database.
        rm -f /var/lib/logrotate/status-argent-sentinel-nginx

        /usr/bin/argent-sentinel --config "$CONFIG" validate-config
        /usr/sbin/argent-sentinel-api --config "$API_CONFIG" validate-config
        /usr/sbin/argent-sentinel-dashboard --config "$DASH_CONFIG" validate-config
        /usr/sbin/argent-sentinel-review-processor --config "$REVIEW_CONFIG" validate-config

        install -d -o root -g root -m 0700 "$BACKUP"
        cp -a "$CONFIG" "$BACKUP/collector.json"
        cp -a "$API_CONFIG" "$BACKUP/server-api.json"
        /usr/bin/argent-sentinel --config "$CONFIG" migrate --backup-dir "$BACKUP" >/dev/null

        if [ -d /run/systemd/system ] &&
           command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
            systemctl enable                 argent-sentinel-collector.timer                 argent-sentinel-report-batch.timer                 argent-sentinel-api.service                 argent-sentinel-nginx-logrotate.timer                 argent-sentinel-fail2ban-export.timer                 argent-sentinel-review-digest.timer                 argent-sentinel-nginx-429-export.timer                 argent-sentinel-dashboard-snapshot.timer                 argent-sentinel-awstats.timer                 argent-sentinel-dashboard.service                 argent-sentinel-review-processor.path                 >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-api.service                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-api.service                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-collector.timer                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-collector.timer                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-report-batch.timer                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-report-batch.timer                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-nginx-logrotate.timer                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-nginx-logrotate.timer                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-fail2ban-export.timer                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-fail2ban-export.timer                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-review-digest.timer                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-review-digest.timer                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-nginx-429-export.timer                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-nginx-429-export.timer                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-dashboard-snapshot.timer                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-dashboard-snapshot.timer                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-awstats.timer                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-awstats.timer                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-dashboard.service                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-dashboard.service                     >/dev/null 2>&1 || true
            systemctl restart argent-sentinel-review-processor.path                 >/dev/null 2>&1 ||
                systemctl start argent-sentinel-review-processor.path                     >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
