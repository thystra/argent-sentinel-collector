[Unit]
Description=Send Argent Sentinel daily operator review
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/argent-sentinel/collector.json

[Service]
Type=oneshot
ExecStart=/usr/sbin/argent-sentinel-review-digest --config /etc/argent-sentinel/collector.json
User=root
Group=root
RuntimeDirectory=argent-sentinel
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/argent-sentinel/collector
ReadWritePaths=/run/argent-sentinel
ReadWritePaths=-/var/spool/postfix -/var/lib/postfix
ReadWritePaths=-/var/spool/exim4 -/var/spool/mqueue
