[Unit]
Description=Send Argent Sentinel CIDR abuse-report batches hourly

[Timer]
OnCalendar=*-*-* *:05:00
AccuracySec=30s
RandomizedDelaySec=30s
Persistent=true
Unit=argent-sentinel-report-batch.service

[Install]
WantedBy=timers.target

