[Unit]
Description=Export Fail2ban bans into Argent Sentinel
After=fail2ban.service
ConditionPathExists=/etc/argent-sentinel/collector.json

[Service]
Type=oneshot
ExecStart=/usr/sbin/argent-sentinel-fail2ban-export --config /etc/argent-sentinel/collector.json
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/argent-sentinel /run/argent-sentinel
