[Unit]
Description=Argent Sentinel central mTLS ingestion API
After=network.target
Before=nginx.service
ConditionPathExists=/etc/argent-sentinel/server-api.json

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/sbin/argent-sentinel-api --config /etc/argent-sentinel/server-api.json serve
RuntimeDirectory=argent-sentinel
RuntimeDirectoryMode=0755
UMask=0027
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/argent-sentinel
ReadWritePaths=/var/lib/argent-sentinel
ReadWritePaths=/run/argent-sentinel

[Install]
WantedBy=multi-user.target
