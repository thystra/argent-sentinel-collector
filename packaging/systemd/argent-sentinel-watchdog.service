# /home/alan/src/argent-sentinel-collector/packaging/systemd/argent-sentinel-watchdog.service
[Unit]
Description=Run due Argent Sentinel watchdog modules
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/argent-sentinel/watchdog.json

[Service]
Type=oneshot
ExecStart=/usr/sbin/argent-sentinel-watchdog --config /etc/argent-sentinel/watchdog.json run
TimeoutStartSec=10min
User=root
Group=root
UMask=0027
RuntimeDirectory=argent-sentinel
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/argent-sentinel/watchdogs
ReadWritePaths=/run/argent-sentinel
ReadWritePaths=-/var/spool/postfix -/var/lib/postfix
ReadWritePaths=-/var/spool/exim4 -/var/spool/mqueue

# EOF: /home/alan/src/argent-sentinel-collector/packaging/systemd/argent-sentinel-watchdog.service
