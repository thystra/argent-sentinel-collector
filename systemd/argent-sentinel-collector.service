[Unit]
Description=Argent Sentinel event collector
Documentation=file:/usr/local/share/doc/argent-sentinel-collector/README.md
After=network-online.target crowdsec.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/argent-sentinel/collector.py --config /etc/argent-sentinel/collector.json run
RuntimeDirectory=argent-sentinel
RuntimeDirectoryMode=0750
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
AmbientCapabilities=
ReadWritePaths=/var/lib/argent-sentinel
ReadWritePaths=/run/argent-sentinel
ReadWritePaths=-/var/spool/postfix
ReadWritePaths=-/var/lib/postfix

[Install]
WantedBy=multi-user.target
